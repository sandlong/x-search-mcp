{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x-search-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
